OPENAI_API_KEY=
GROQ_API_KEY=
SESSION_SECRET=
APP_BASE_URL=http://localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google verifies identity. Only these addresses may use IAssistant (comma-separated).
ALLOWED_EMAILS=
# Provisioned passwords only. email:password pairs, separated by semicolons or new lines. No sign-up.
AUTH_PASSWORDS=
AUTH_REQUIRED=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# AI stack is configured here only (not in the app UI). Defaults use Groq.
LLM_PROVIDER=groq
STT_PROVIDER=groq
PROVIDER_STACK=groq
TRANSCRIPTION_MODEL=
ANSWER_MODEL=
GROQ_STT_MODEL=
GROQ_ANSWER_MODEL=
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
HANDS_FREE=true
QUESTION_CONFIDENCE_THRESHOLD=0.80
MAX_ANSWER_WORDS=100
MIN_ANSWER_WORDS=40
ANSWER_COOLDOWN_SEC=0.35
GROQ_CHUNK_SECONDS=4
GROQ_CHUNK_OVERLAP_MS=450
GROQ_CHUNK_SILENCE_MS=750
