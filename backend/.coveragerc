[run]
source = app
branch = True
relative_files = True
omit =
    app/oauth_providers.py
    app/stt_groq_chunked.py

[report]
show_missing = True
skip_covered = False
fail_under = 70
precision = 1
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError

[html]
directory = htmlcov
