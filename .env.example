OPENAI_API_KEY=
GROQ_API_KEY=

# OAuth (optional). Accounts + setup stored in server memory until restart.
SESSION_SECRET=
# Public URL users open in the browser (Render: https://your-frontend.onrender.com).
APP_BASE_URL=http://localhost
# Extra CORS origins (comma-separated). APP_BASE_URL is always allowed when set.
CORS_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google verifies identity. Only these addresses may use IAssistant (comma-separated).
ALLOWED_EMAILS=
# Provisioned passwords only. email:password pairs, separated by semicolons or new lines. No sign-up.
AUTH_PASSWORDS=
AUTH_REQUIRED=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional future: PostgreSQL persistence (set DATABASE_URL in backend only)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

LLM_PROVIDER=ollama
STT_PROVIDER=browser
TRANSCRIPTION_MODEL=
ANSWER_MODEL=
GROQ_STT_MODEL=
GROQ_ANSWER_MODEL=
OLLAMA_MODEL=llama3.2:3b
HANDS_FREE=true
QUESTION_CONFIDENCE_THRESHOLD=0.80
MAX_ANSWER_WORDS=100
MIN_ANSWER_WORDS=40
ANSWER_COOLDOWN_SEC=0.35
GROQ_CHUNK_SECONDS=4
GROQ_CHUNK_OVERLAP_MS=450
GROQ_CHUNK_SILENCE_MS=750
COMPOSE_PROFILES=free
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
